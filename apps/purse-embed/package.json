{
  "name": "@purse/embed",
  "version": "0.0.1",
  "private": true,
  "description": "The Purse embed app: the sign-in, identity, wallet, entry-confirm and rewards flows the SDK mounts in an iframe on the Purse origin (system spec 4.8). A static export served by the Purse API under /embed.",
  "type": "module",
  "scripts": {
    "dev": "next dev --port 4100",
    "build": "next build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "clean": "rm -rf .next out dist"
  },
  "dependencies": {
    "@purse/types": "workspace:*",
    "@sideout/ui": "workspace:*",
    "next": "~15.5.25",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@repo/config": "workspace:*",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.0",
    "vitest": "^5.0.1"
  }
}
