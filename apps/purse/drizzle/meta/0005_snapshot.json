        "accounts_normal_side_by_kind": {
          "name": "accounts_normal_side_by_kind",
          "value": "\"accounts\".\"normal_side\" = (case \"accounts\".\"kind\"\n        when 'user_wallet' then 'credit'\n        when 'contest_escrow' then 'credit'\n        when 'sponsor_funding' then 'debit'\n        when 'promo_liability' then 'credit'\n        when 'platform_fee' then 'credit'\n        when 'external_settlement' then 'debit'\n      end)::ledger_side"
        },
        "accounts_owner_ref_by_kind": {
          "name": "accounts_owner_ref_by_kind",
          "value": "case \"accounts\".\"kind\"\n        when 'user_wallet' then \"accounts\".\"owner_ref\" is not null and \"accounts\".\"owner_ref\" ~ '^usr_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$'\n        when 'contest_escrow' then \"accounts\".\"owner_ref\" is not null and \"accounts\".\"owner_ref\" ~ '^cnt_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$'\n        else true\n      end"
        }
      },
      "isRLSEnabled": false
    },
