# There is deliberately no root .env. Each app loads its own file so the two connection
# strings are never in one process (decision D2):
#
#   apps/purse/.env      PURSE_DATABASE_URL, PURSE_DATABASE_URL_TEST, PORT, LOG_LEVEL
#   apps/sideout/.env    SIDEOUT_DATABASE_URL, SIDEOUT_DATABASE_URL_TEST, LOG_LEVEL
#
# See apps/purse/.env.example and apps/sideout/.env.example for every variable with a
# comment. `pnpm db:setup` writes both files with local defaults.
#
# Variables read only by tooling at the root:

# Admin connection `pnpm db:setup` uses to create roles and databases. Defaults to the
# local socket-less connection a Homebrew Postgres accepts.
DATABASE_ADMIN_URL=postgres://localhost:5432/postgres
# Passwords `db:setup` and docker compose give the two application roles.
PURSE_DB_PASSWORD=purse_app
SIDEOUT_DB_PASSWORD=sideout_app
# docker compose only
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
