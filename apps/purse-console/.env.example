# The operator console (apps/purse-console). No database, no secret key: the console keeps
# an operator session token in an HttpOnly cookie and calls the Purse API server-to-server.

# Where the Purse API answers /console/*. Must be https:// (or loopback) in production.
PURSE_API_ORIGIN=http://localhost:4000

# development | test | production. Production marks the session cookie Secure.
NODE_ENV=development
LOG_LEVEL=info
