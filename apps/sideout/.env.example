# Sideout web app. Copy to apps/sideout/.env (gitignored): these defaults match the compose
# Postgres, and `pnpm db:setup` writes the file for any other one.
#
# Sideout knows only its own database. Purse's connection string must never appear in this
# process; a test proves the env loader ignores it even when set. Sideout will talk to
# Purse over HTTPS with a secret key (phase 7), never through Purse's database.
SIDEOUT_DATABASE_URL=postgres://sideout_app:sideout_app@localhost:5432/sideout
# Used instead of SIDEOUT_DATABASE_URL when NODE_ENV=test. Tests reset this database.
SIDEOUT_DATABASE_URL_TEST=postgres://sideout_app:sideout_app@localhost:5432/sideout_test

# --- Purse -------------------------------------------------------------------------
# How Sideout reaches Purse. Without these the app runs, but every contest call answers
# `purse_unavailable`, the entry step cannot mount, and `pnpm db:seed` leaves
# `purse_contest_id` null on every tournament: the half of the product that lives on the
# platform is simply absent. `pnpm db:setup` does not write them, because they come from
# Purse's seed rather than from the database.
#
# Get the keys from Purse's own seed, which prints them once, when it creates them:
#   pnpm --filter @purse/api run db:seed -- --print-keys --rotate-keys
#
# The API Sideout calls server to server. `pnpm dev` runs it on 4000.
PURSE_API_URL=http://localhost:4000
# The secret key, server-side only. `scripts/check-bundle.ts` fails the build if `sk_`
# reaches the client bundle. Named with the SIDEOUT_ prefix because PURSE_SECRET_KEY is
# Purse's own process secret and the two apps share an environment locally and in CI.
# SIDEOUT_PURSE_SECRET_KEY=sk_sandbox_...
# Verifies `Purse-Signature` on POST /api/webhooks/purse; unset, the receiver answers 503.
# Purse returns it once, when the endpoint is registered.
# PURSE_WEBHOOK_SECRET=whsec_...
# What the browser needs for `Purse.init`. The publishable key is public by design.
# NEXT_PUBLIC_PURSE_PUBLISHABLE_KEY=pk_sandbox_...
# The origin the iframe is served from, as the browser reaches it. Two valid choices in
# development (docs/decisions.md, "Embed app hosting"): 4100 is the embed's own dev server
# and needs nothing built; 4000 is the API serving a built copy, which is how it is
# deployed, and answers `embed_not_built` until `pnpm --filter @purse/embed build` runs.
NEXT_PUBLIC_PURSE_ORIGIN=http://localhost:4100
# The tenant `pnpm --filter @purse/api db:seed` creates. A hosted deploy sets its own.
NEXT_PUBLIC_PURSE_TENANT_ID=tnt_01a0b16a-b475-74d4-b1cb-2dbdc08845a9
#
# Purse only accepts an embed handshake from an origin the tenant has registered. The seed
# registers http://localhost:3000 and http://127.0.0.1:3000, so serving Sideout on another
# port needs that origin added to the tenant before the frame will load.

# debug | info | warn | error
LOG_LEVEL=info
# Commit sha reported by /health. Set by the build in deployed environments; falls back to
# `git rev-parse HEAD` locally and to "unknown" when neither is available.
# BUILD_SHA=

# Signs session cookies and one-time sign-in codes. At least 32 characters. Required in
# production (the process refuses to boot without it); outside production a fixed
# development secret is used when unset.
# SESSION_SECRET=

# How one-time codes are delivered. `log` writes the code to the structured log and is the
# default outside production; it is refused in production. With no provider configured,
# production answers request-code with `sms_unavailable` (503) until phase 9 wires a real
# sender (docs/decisions.md).
SMS_PROVIDER=log

# How many proxies in front of this process append to X-Forwarded-For (0-10). 0 means the
# process is reached directly; Railway is 1. Feeds the per-address sign-in rate limit.
TRUSTED_PROXY_HOPS=0

# Stripe, for charitable donations. Set both or neither: one without the other is refused.
# Unset outside production selects the `dev` donation provider (no real money); unset in
# production makes registration refuse with `donation_provider_unavailable` (503).
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# How long a registration whose donation is still pending holds its place (1-1440 minutes).
# Judged when capacity is read; there is no background job.
RESERVATION_TTL_MINUTES=30

# Sign-in codes this instance may send in any ten-minute window, across every number: the
# SMS budget. Per-address (5) and per-phone (3) caps over the same window are fixed in code.
# Set it to what the SMS account should be allowed to spend once a provider is wired.
AUTH_CODE_GLOBAL_CAP=600

# Public demo sign-in (docs/demo-accounts.md): true turns on the account picker and
# POST /api/auth/demo; off by default. A build-time value too (the Dockerfile build
# argument); NEXT_PUBLIC_DEMO_ACCOUNTS is derived from it by next.config.ts, never set by hand.
DEMO_ACCOUNTS=
