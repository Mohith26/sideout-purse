# Purse API. Copy to apps/purse/.env (gitignored): these defaults match the compose Postgres,
# and `pnpm db:setup` writes the file for any other one.
#
# Purse knows only its own database. Sideout's connection string must never appear in this
# process; a test proves the env loader ignores it even when set.
#
# Two roles, one database (docs/decisions.md, "Two Purse database roles"):
#   purse_app        the runtime role the API serves with. It owns nothing and cannot UPDATE
#                    or DELETE journal rows; that is enforced by Postgres, not by code.
#   purse_migrator   owns the database and every table. Only `pnpm db:migrate`,
#                    `pnpm db:seed` and the test reset use it. A deployed API process should
#                    receive PURSE_DATABASE_URL only.
PURSE_DATABASE_URL=postgres://purse_app:purse_app@localhost:5432/purse
PURSE_MIGRATOR_DATABASE_URL=postgres://purse_migrator:purse_migrator@localhost:5432/purse
# Used instead of the above when NODE_ENV=test. Tests reset this database.
PURSE_DATABASE_URL_TEST=postgres://purse_app:purse_app@localhost:5432/purse_test
PURSE_MIGRATOR_DATABASE_URL_TEST=postgres://purse_migrator:purse_migrator@localhost:5432/purse_test

# Port the API listens on.
PORT=4000
# debug | info | warn | error
LOG_LEVEL=info
# Commit sha reported by /health. Set by the build in deployed environments; falls back to
# `git rev-parse HEAD` locally and to "unknown" when neither is available.
# BUILD_SHA=

# Bearer token for GET /internal/reconcile (the invariant report). Required outside tests:
# when unset, the route refuses every request. Only NODE_ENV=test may call it unauthenticated.
# Generate one with: openssl rand -hex 32
# INTERNAL_API_TOKEN=

# The randomized ledger test (test/ledger/random-ops.test.ts) reads these; CI runs the full
# count and refuses a smaller one. Lower LEDGER_RANDOM_OPS for a quick local watch run.
# LEDGER_RANDOM_OPS=10000
# LEDGER_RANDOM_SEED=20260917

# Public /docs key minting: defaults true outside production, false in production.
# Public demo on Railway: set SANDBOX_SELF_SERVE=true on the Purse service.
# SANDBOX_SELF_SERVE=false
