{
  "name": "@sideout/web",
  "version": "0.0.1",
  "private": true,
  "description": "Sideout: the charity beach volleyball tournament product, a third-party client of Purse.",
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:generate:custom": "drizzle-kit generate --custom",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "clean": "rm -rf .next dist"
  },
  "dependencies": {
    "@purse/sdk": "workspace:*",
    "@purse/types": "workspace:*",
    "@repo/db": "workspace:*",
    "@repo/ids": "workspace:*",
    "@repo/logger": "workspace:*",
    "@sideout/ui": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "next": "~15.5.25",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@repo/config": "workspace:*",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "vitest": "^5.0.1"
  }
}
